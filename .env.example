# ---------------------------------------------------------------------------
# SilkCite — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development:
#
#   cp .env.example .env.local
#
# Both variables are public (NEXT_PUBLIC_* is exposed to the browser) and are
# read at build time by Next.js / Vercel.
# ---------------------------------------------------------------------------

# The public Calendly scheduling page opened by every "Schedule a Call" button.
# Must be a valid https:// URL. Opened in a new tab.
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/vishnu-silkcite/30min"

# Canonical public origin (no trailing slash). Used for canonical URLs,
# sitemap.xml, robots.txt, and Open Graph/Twitter metadata.
NEXT_PUBLIC_SITE_URL="https://silkcite.io"
