# ---------------------------------------------------------------------------
# SilkCite — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` (preferred) or `.env` for local development
# and fill in real values. Never commit real credentials.
#
#   cp .env.example .env.local
#
# All secrets/configuration are read server-side. Only variables prefixed with
# NEXT_PUBLIC_ are ever exposed to the browser, and only the ones listed below.
# ---------------------------------------------------------------------------

# --- Public configuration (safe to expose to the browser) -------------------

# The public Calendly scheduling page opened by every "Schedule a Call" button.
# Must be a valid https:// URL. Opened in a new tab.
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/your-account/silkcite-intro"

# Canonical public origin, used for canonical URLs, sitemap.xml, robots.txt,
# and Open Graph/Twitter metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://silkcite.io"

# Optional. Cloudflare Turnstile site key. When set together with
# TURNSTILE_SECRET_KEY, the lead form renders the Turnstile widget and the
# server verifies the token. Leave empty to disable Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- Server-only secrets (NEVER exposed to the browser) ---------------------

# PostgreSQL connection string (pooled endpoint recommended for serverless).
# Example (Neon / Supabase / RDS):
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require
DATABASE_URL=""

# Optional. Cloudflare Turnstile secret key (server-side only).
TURNSTILE_SECRET_KEY=""

# Optional. Distributed rate limiting via Upstash Redis (recommended for
# multi-instance / serverless). When omitted, an in-memory limiter is used,
# which is per-instance only (fine for local dev and single-instance deploys).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Set to "true" to trust proxy headers (X-Forwarded-For, X-Real-IP,
# CF-Connecting-IP) when deriving a client IP for rate limiting. This is
# auto-enabled on Vercel. Only enable behind a proxy you control; otherwise
# clients can spoof the header and bypass per-IP limits.
TRUST_PROXY_HEADERS=""

# Optional. Salt used to hash identifiers (e.g. client IP) before they are
# written to server logs, so raw IPs are never stored in logs. Provide a long
# random value in production.
LOG_HASH_SALT=""

# Optional. Comma-separated list of additional origins allowed to call the
# state-changing API (used for CSRF origin checks). Your own origin is always
# allowed. Example: "https://app.silkcite.io"
ALLOWED_ORIGINS=""

# Optional. Maximum connections in the PostgreSQL pool (per instance).
# Lower values are safer on serverless platforms.
DATABASE_POOL_MAX="3"
